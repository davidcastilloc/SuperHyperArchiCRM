{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "aedd0159259bcb5220041dfe0f088976",
  "name": "shac-node-worker",
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web-spa/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shac-primary",
      "database_id": "e9600aff-1439-4a91-8a12-c5d1d14953bd",
      "migrations_dir": "../../packages/db-d1/migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BRANCH_DO",
        "class_name": "BranchInventoryDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BranchInventoryDO"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "14c739e1ee8c49619668446fbe1ca1b4"
    },
    {
      "binding": "SESSION_KV",
      "id": "c0a4248c265040db8587431689fe9c69"
    }
  ],
  "vars": {
    "CORS_ALLOWED_ORIGINS": ""
  }
}
