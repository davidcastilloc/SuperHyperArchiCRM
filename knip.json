{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "apps/web-spa/dist/**",
    "**/.wrangler/**"
  ],
  "workspaces": {
    "apps/node-worker": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/control-plane": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/federation-hub": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/web-spa": {
      "entry": ["src/main.tsx!", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}"]
    },
    "editions/presets": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/kernel": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "ignoreExportsUsedInFile": { "interface": true, "type": true }
    },
    "packages/db-d1": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "ignoreDependencies": ["zod"]
    },
    "packages/actor-branch": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/federation-sdk": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts!", "test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}"]
    },
    "packages/modules/iam": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/modules/customers": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/modules/catalog": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/modules/regional": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/modules/pos": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/modules/wms": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "ignoreDependencies": ["@shac/actor-branch"]
    },
    "packages/modules/spaces": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "ignoreExportsUsedInFile": true
    },
    "packages/modules/leases": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    }
  }
}
