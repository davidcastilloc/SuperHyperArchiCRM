{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "apps/web-spa/dist/**",
    "**/.wrangler/**"
  ],
  "workspaces": {
    "apps/node-worker": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/web-spa": {
      "entry": ["src/main.tsx!", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}"]
    },
    "packages/modules/iam": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    }
  }
}
